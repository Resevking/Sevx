# ---------------------------------------------------------------------------
# TrueCloud – Konfiguration. Kopieren nach .env und ausfüllen.
# ---------------------------------------------------------------------------

# Öffentliche Adresse der Website (ohne Schrägstrich am Ende)
APP_URL=https://truecloud.online

# PostgreSQL. Bei docker compose wird DATABASE_URL automatisch gesetzt.
DATABASE_URL=postgresql://truecloud:truecloud@localhost:5432/truecloud
POSTGRES_PASSWORD=bitte-ein-langes-zufaelliges-passwort

# Kommagetrennte Liste von E-Mail-Adressen mit Admin-Zugang (/dashboard/admin)
ADMIN_EMAILS=deine-adresse@beispiel.ch

# Geheimer Schlüssel für den Aufräumjob (/api/cron/cleanup). Erzeugen z. B. mit: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# OVHcloud Object Storage (S3-kompatibel)
# Werte aus dem OVHcloud Control Panel: Public Cloud → Object Storage
# ---------------------------------------------------------------------------
# Endpoint deiner Region, z. B. https://s3.gra.io.cloud.ovh.net (Gravelines),
# https://s3.sbg.io.cloud.ovh.net (Strassburg) oder https://s3.de.io.cloud.ovh.net (Frankfurt)
S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=truecloud-userdata
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Auf true setzen, falls der Bucket-Name Punkte enthält
S3_FORCE_PATH_STYLE=false
# Zusätzliche erlaubte Upload-Herkünfte für CORS (z. B. http://localhost:3000 zum Testen)
CORS_EXTRA_ORIGINS=

# ---------------------------------------------------------------------------
# Stripe – Schlüssel unter https://dashboard.stripe.com/apikeys
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
# Wird von "npm run stripe:setup" ausgegeben (bzw. von "stripe listen" lokal)
STRIPE_WEBHOOK_SECRET=whsec_...
# Wird von "npm run stripe:setup" ausgegeben
STRIPE_PORTAL_CONFIGURATION_ID=
# Auf true setzen, wenn Stripe Tax die MWST automatisch berechnen soll
STRIPE_AUTOMATIC_TAX=false

# ---------------------------------------------------------------------------
# E-Mail-Versand (SMTP). Ohne SMTP_HOST werden Mails nur ins Log geschrieben.
# OVHcloud-Mailpakete: ssl0.ovh.net, Port 465
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TrueCloud <no-reply@truecloud.online>
