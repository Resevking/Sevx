# Kopiere diese Datei nach ".env" und trage deine Werte ein.

# Client-ID deiner Twitch-App (https://dev.twitch.tv/console → Anwendung registrieren, Client-Typ "Öffentlich")
TWITCH_CLIENT_ID=

# Nur nötig, wenn die Twitch-App als "Vertraulich" angelegt wurde
TWITCH_CLIENT_SECRET=

# Passwort aus OBS → Werkzeuge → WebSocket-Server-Einstellungen
OBS_PASSWORD=

# Optional statt "npm run auth": fertiges Token einfügen (wird dann NICHT automatisch erneuert)
# TWITCH_BOT_TOKEN=
# TWITCH_BROADCASTER_TOKEN=

# Mehr Ausgaben zur Fehlersuche: debug
# LOG_LEVEL=info
